{
	"name": "obsidian-spherical-graph",
	"version": "1.6.1",
	"description": "Explore your vault as a globe: notes are cities, links are roads, tags orbit as satellites, and Route Finder reveals every shortest path.",
	"private": true,
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "npm run typecheck && node esbuild.config.mjs production",
		"typecheck": "tsc --noEmit",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "eslint . --max-warnings=0",
		"test": "vitest run",
		"test:coverage": "vitest run --coverage",
		"validate:release": "node scripts/validate-release.mjs",
		"check": "npm run lint && npm run typecheck && npm run test && npm run build && npm run validate:release",
		"benchmark:layout": "tsx scripts/benchmark-layout.ts",
		"generate:test-vault": "node scripts/generate-test-vault.mjs"
	},
	"keywords": [
		"obsidian",
		"graph",
		"sphere",
		"three.js",
		"webgl"
	],
	"author": "Pavel-mik",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Pavel-mik/obsidian-spherical-graph.git"
	},
	"bugs": {
		"url": "https://github.com/Pavel-mik/obsidian-spherical-graph/issues"
	},
	"homepage": "https://github.com/Pavel-mik/obsidian-spherical-graph#readme",
	"engines": {
		"node": ">=20"
	},
	"devDependencies": {
		"@eslint/js": "^9.39.4",
		"@types/node": "^22.15.17",
		"@types/three": "^0.185.1",
		"@vitest/coverage-v8": "^4.1.10",
		"esbuild": "^0.28.1",
		"eslint": "^9.39.4",
		"eslint-plugin-obsidianmd": "^0.4.1",
		"globals": "^17.6.0",
		"jiti": "^2.6.1",
		"obsidian": "1.7.2",
		"tsx": "^4.23.1",
		"typescript": "^5.8.3",
		"typescript-eslint": "^8.59.1",
		"vitest": "^4.1.10"
	},
	"dependencies": {
		"three": "^0.185.1"
	}
}
